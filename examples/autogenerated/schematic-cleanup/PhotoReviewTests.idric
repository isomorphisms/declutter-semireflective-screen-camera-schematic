module PhotoReviewTests

import Data.Buffer
import Data.List
import Data.Text
import FreshFiles
import PhotoRequests
import PhotoReview
import SchematicRaster
import System
import System.File
import VerifyCoverage

covering
expect : Text → Bool → IO ()
expect name True = putStrLn ("PASS\t" ++ name)
expect name False = do
  putStrLn ("FAIL\t" ++ name)
  exitFailure

is_left : Either failure value → Bool
is_left (Left _) = True
is_left _ = False

good_digest : Text
good_digest = pack (replicate 64 'a')

row_with : Text → Text → Text → Text → Text → Text
row_with identity source digest width reason =
  "region\t" ++ identity ++ "\t" ++ source ++ "\t" ++ digest ++ "\t0\t0\t" ++ width ++ "\t2\t" ++ reason ++ "\tOriginal evidence"

manifest : Text → Text
manifest row = "version\tphoto-requests-v1\n" ++ row ++ "\n"

covering
main : IO ()
main = do
  arguments ← getArgs
  case arguments of
    [_, destination] ⇒ do
      let good_row = row_with "region-a" "original.ppm" good_digest "2" "glare"
      Right regions ← pure (parse_regions (manifest good_row))
        | Left message ⇒ do putStrLn message; exitFailure
      expect "source-bound region admitted" (length regions ≟ 1)
      expect "empty manifests rejected" (is_left (parse_regions "version\tphoto-requests-v1\n"))
      expect "duplicate identifiers rejected" (is_left (parse_regions (manifest (good_row ++ "\n" ++ good_row))))
      expect "source traversal rejected" (is_left (parse_regions (manifest (row_with "a" "../original.ppm" good_digest "2" "glare"))))
      expect "invalid digest rejected" (is_left (parse_regions (manifest (row_with "a" "original.ppm" "bad" "2" "glare"))))
      expect "zero rectangle rejected" (is_left (parse_regions (manifest (row_with "a" "original.ppm" good_digest "0" "glare"))))
      expect "large crop rejected" (is_left (parse_regions (manifest (row_with "a" "original.ppm" good_digest "513" "glare"))))
      expect "unknown reason rejected" (is_left (parse_regions (manifest (row_with "a" "original.ppm" good_digest "2" "confidence-99"))))
      expect "markup identifier rejected" (is_left (parse_regions (manifest (row_with "<script>" "original.ppm" good_digest "2" "glare"))))
      expect "processing loss never requests retake" (not (needs_photograph processing_loss))
      expect "unchecked never requests retake" (not (needs_photograph unchecked_region))
      expect "preserved appearance never requests retake" (not (needs_photograph preserved_appearance))
      expect "all acquisition reasons request evidence" (all needs_photograph [glare_obscures, blurred_detail, missing_coverage, disagreeing_views, uncertain_alignment])
      expect "HTML text escaped" (escape_html "<script>&\"'" ≟ "&lt;script&gt;&amp;&quot;&#39;")
      expect "manifest roundtrip" (case parse_regions (manifest (region_row (RegionForReview "a" "original.ppm" good_digest 0 0 2 2 processing_loss "<evidence>"))) of
        Right [_] ⇒ True
        _ ⇒ False)
      Right image ← new_image 2 2
        | Left message ⇒ do putStrLn message; exitFailure
      _ ← put_pixel image 0 0 (RGB 255 0 0)
      _ ← put_pixel image 1 0 (RGB 0 255 0)
      _ ← put_pixel image 0 1 (RGB 0 0 255)
      _ ← put_pixel image 1 1 (RGB 11 22 33)
      invalid ← bitmap_from image 1 1 2 2 1
      expect "out-of-frame crop rejected" (is_left invalid)
      invalid_step ← bitmap_from image 0 0 2 2 0
      expect "zero sampling step rejected" (is_left invalid_step)
      Right (bytes, count) ← bitmap_from image 0 0 2 2 1
        | Left message ⇒ do putStrLn message; exitFailure
      Right () ← write_new_buffer destination bytes count
        | Left message ⇒ do putStrLn message; exitFailure
      expect "BMP includes row padding" (count ≟ 70)
      Just pixel ← pixel_at image 1 1
        | Nothing ⇒ exitFailure
      expect "encoding leaves original RGB unchanged" (pixel.red ≟ 11 && pixel.green ≟ 22 && pixel.blue ≟ 33)
      Right identities ← new_image 2 2
        | Left message ⇒ do putStrLn message; exitFailure
      _ ← for_indices_result 2 0 $ \y ⇒ for_indices_result 2 0 $ \x ⇒ do
        _ ← put_pixel identities x y (RGB 18 18 18)
        pure (the (Either Text ()) (Right ()))
      let wire = WitnessedFeature "wire" wire_segment observed 0 0 2 2 "original-wire" "none"
      let marking = WitnessedFeature "marking" legible_text observed 0 0 2 2 "original-marking" "none"
      let uncertain_endpoint = WitnessedFeature "unknown-endpoint" wire_endpoint ambiguous 0 0 1 1 "occluded-endpoint" "none"
      let unseen_marking = WitnessedFeature "unseen-marking" terminal_mark unobserved 0 0 1 1 "no-established-identity" "none"
      let wire_probe = StrokeBesideBackground "wire" 1 0 0 0 0 (RGB 0 255 0) (RGB 255 0 0)
      let mark_probe = StrokeBesideBackground "marking" 1 0 0 0 0 (RGB 0 255 0) (RGB 255 0 0)
      let coverage = NativePreservationSlice 18 2 2 good_digest good_digest "test" 2 2 0 0 good_digest (pack (replicate 40 'a')) [wire, marking, uncertain_endpoint, unseen_marking] [wire_probe, mark_probe]
      Right supported ← coverage_regions coverage image image image identities "original.ppm"
        | Left message ⇒ do putStrLn message; exitFailure
      expect "coverage adapter retains observed local PASS" (length (filter (\region ⇒ reason_name region.reason ≟ "preserved") supported) ≟ 2)
      expect "coverage adapter requests evidence for unresolved witnesses" (length (filter (\region ⇒ needs_photograph region.reason) supported) ≟ 2)
      expect "unobserved does not invent a cause" (not (any (\region ⇒ reason_name region.reason ≟ "missing-coverage" || reason_name region.reason ≟ "glare") supported))
      Right clipped ← new_image 2 2
        | Left message ⇒ do putStrLn message; exitFailure
      Right damaged ← coverage_regions coverage image image clipped identities "original.ppm"
        | Left message ⇒ do putStrLn message; exitFailure
      expect "actual contrast failures become processing repair" (length (filter (\region ⇒ reason_name region.reason ≟ "processing-loss") damaged) ≟ 2)
      expect "contrast failures do not create retake requests" (length (filter (\region ⇒ needs_photograph region.reason) damaged) ≟ 2)
      _ ← put_pixel identities 0 0 (RGB 19 19 19)
      foreign_map ← coverage_regions coverage image image image identities "original.ppm"
      expect "foreign ownership is an error, not a photo request" (is_left foreign_map)
      putStrLn "PASS\tphoto-review focused host suite"
    _ ⇒ do
      putStrLn "usage: photo-review-tests NEW-BMP-PATH"
      exitFailure
